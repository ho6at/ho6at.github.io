---
// Shows `src` when given; otherwise a placeholder tinted by `tone`, labelled with the photo that belongs here.
interface Props {
  src?: string;
  alt: string;
  ratio?: string;
  tone?: 'dawn' | 'day' | 'golden' | 'blue';
  class?: string;
  [key: `data-${string}`]: string | number;
}
const { src, alt, ratio = '4 / 5', tone, class: className, ...rest } = Astro.props;
---

<figure class:list={['photo', tone && `tone-${tone}`, className]} style={`aspect-ratio: ${ratio}`} {...rest}>
  {src ? <img src={src} alt={alt} loading="lazy" /> : <figcaption>{alt}</figcaption>}
</figure>

<style>
  .photo {
    margin: 0;
    overflow: hidden;
    background:
      radial-gradient(120% 80% at 70% 110%, rgb(217 146 46 / 0.28), transparent 60%),
      linear-gradient(180deg, #c9cfd4, #9aa6af);
    border-radius: 3px;
    display: flex;
    align-items: flex-end;
  }
  .tone-dawn {
    background: linear-gradient(175deg, #6b5a7e, #eea58c 55%, #f8e7dc);
  }
  .tone-day {
    background: linear-gradient(175deg, #a9c6de, #d6e4ee 55%, #f6f8f9);
  }
  .tone-golden {
    background: linear-gradient(175deg, #efbd74, #f6d7a4 55%, #fbefdc);
  }
  .tone-blue {
    background: linear-gradient(175deg, #1b2e5a, #2f4a7a 55%, #6a7aa0);
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  figcaption {
    padding: 0.75rem 0.9rem;
    font-size: 0.8rem;
    color: rgb(31 42 51 / 0.75);
  }
  .tone-blue figcaption {
    color: rgb(255 255 255 / 0.85);
  }
</style>
