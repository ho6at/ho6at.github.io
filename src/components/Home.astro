---
import Logo from './Logo.astro';
import Booking from './Booking.astro';
import LanguageGate from './LanguageGate.astro';
import Splash from './Splash.astro';
import Eiffel from './Eiffel.astro';
import LightLogo from './LightLogo.astro';
import { galleryPhotos, srcset, src } from '../lib/photos';
import { languages } from '../i18n/languages';
import { landings, landingIds, landingUi, landingHref } from '../i18n/landings';
import { site } from '../site';
import type fr from '../i18n/fr';

interface Props {
  t: typeof fr;
}
const { t } = Astro.props;
const home = languages.find((l) => l.code === t.lang)?.href ?? '/';
const quoteHref = `mailto:${site.email}?subject=${encodeURIComponent(t.brands.quoteSubject)}`;
const reelLight = ['golden', 'dawn', 'day', 'night'];
const strings = {
  names: t.light.names,
  locale: t.locale,
  email: site.email,
  whatsapp: site.whatsapp,
  subject: t.sessions.subject,
  message: t.sessions.message,
  around: t.sessions.around,
  packages: t.sessions.packages,
  custom: t.sessions.custom,
  peopleLabel: t.sessions.peopleLabel,
  langNames: Object.fromEntries(languages.map((l) => [l.code, l.name])),
  stepOf: t.sessions.stepOf,
  steps: t.sessions.steps,
};
---

<header class="top" data-top>
  <div class="wrap bar">
    <Logo href={home} />
    <nav class="pill" aria-label="Main">
      <a href="#sessions">{t.nav.sessions}</a>
      <a href="#places">{t.nav.places}</a>
      {site.showBrands && <a href="#brands">{t.nav.brands}</a>}
      <a href="#team">{t.nav.about}</a>
      <a href="#contact">{t.nav.contact}</a>
    </nav>
    <div class="bar-end">
      <nav class="langs" aria-label="Language">
        {
          languages.map((l) => (
            <a
              href={l.href}
              hreflang={l.code}
              lang={l.code}
              aria-label={l.name}
              aria-current={l.code === t.lang ? 'page' : undefined}
            >
              {l.short}
            </a>
          ))
        }
      </nav>
      <button class="button bar-book" type="button" data-open-booking>{t.nav.book}</button>
    </div>
  </div>
</header>

<main id="top" data-strings={JSON.stringify(strings)}>
  <!-- Hero: the Luminoor Paris logo under a soft studio light -->
  <section class="hero" data-hero>
    <div class="hero-light" aria-hidden="true"></div>
    <div class="hero-eiffel" aria-hidden="true"><Eiffel /></div>
    <div class="hero-follow" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <div class="hero-halo" aria-hidden="true"></div>
      <LightLogo class="hero-mark" waiting />
      <p class="hero-kicker" lang="fr" dir="ltr"><span>Le Flâneur</span></p>
      <h1><span class="sr-only">{t.meta.h1Prefix}</span>{t.hero.title}</h1>
      <p class="hero-lead">{t.hero.lead}</p>
      <div class="hero-actions">
        <button class="button" type="button" data-open-booking>{t.hero.cta}</button>
        <a class="button ghost" href="#gallery">{t.hero.ctaSecondary}</a>
      </div>
    </div>

  </section>

  <!-- Gallery: an exhibition, one photo at a time on black, each with a museum-style label; a tap opens it full screen -->
  <section class="section" id="gallery">
    <div class="wrap head">
      <h2>{t.gallery.title}</h2>
      <p class="lead">{t.gallery.lead}</p>
    </div>
    <ol class="wrap expo" data-gallery>
      {
        galleryPhotos.map((ph, i) => {
          const item = t.gallery.items[ph.id];
          const wide = ph.w > ph.h;
          return (
            <li
              class:list={['shot', { wide }]}
              data-full={srcset(ph.id)}
              data-place={item.place}
              data-light={t.light.names[ph.light]}
              tabindex="0"
              role="button"
            >
              <img
                src={src(ph.id)}
                srcset={srcset(ph.id)}
                sizes={wide ? '(max-width: 700px) 100vw, 70vw' : '(max-width: 700px) 100vw, 50vw'}
                width={ph.w}
                height={ph.h}
                alt={item.alt}
                loading="lazy"
                decoding="async"
              />
              <p class="label">
                <span class="label-n" dir="ltr">N° {String(i + 1).padStart(2, '0')}</span>
                <span>{item.place}</span>
              </p>
            </li>
          );
        })
      }
    </ol>

    <!-- A photo, full screen -->
    <dialog class="lightbox" data-lightbox aria-label={t.gallery.title}>
      <button type="button" class="lb-btn lb-close" data-lb-close aria-label={t.sessions.close}>
        <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
      <figure class="lb-figure" data-lb-stage>
        <img data-lb-img alt="" sizes="100vw" />
        <figcaption>
          <span class="shot-light" data-lb-light></span>
          <span data-lb-place></span>
          <span class="lb-count" data-lb-count dir="ltr"></span>
        </figcaption>
      </figure>
      <button type="button" class="lb-btn lb-nav prev" data-lb-step="-1" aria-label={t.sessions.back}>
        <svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"></path></svg>
      </button>
      <button type="button" class="lb-btn lb-nav next" data-lb-step="1" aria-label={t.sessions.next}>
        <svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"></path></svg>
      </button>
    </dialog>
  </section>

  <!-- How it works: the paparazzi idea in three steps -->
  <section class="section" id="how">
    <div class="wrap head">
      <h2>{t.how.title}</h2>
      <p class="lead">{t.how.lead}</p>
    </div>
    <ol class="wrap how">
      {
        t.how.steps.map((s, i) => (
          <li>
            <span class="how-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.name}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Sessions -->
  <section class="section" id="sessions">
    <div class="wrap head">
      <h2>{t.sessions.title}</h2>
      <p class="lead">{t.sessions.lead}</p>
    </div>
    <div class="wrap">
      <div class="invite plate plate-golden">
        <div class="invite-body">
          <p class="invite-count">{t.sessions.inviteCount}</p>
          <p class="invite-text">{t.sessions.inviteText}</p>
          <button class="button" type="button" data-open-booking>{t.sessions.inviteCta}</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Places -->
  <section class="section" id="places">
    <div class="wrap head">
      <h2>{t.places.title}</h2>
      <p class="lead">{t.places.lead}</p>
    </div>
    <div class="rail rail-places">
      {
        t.places.items.map((p) => (
          <article class={`place plate plate-${p.light}`}>
            <span class={`badge dot-${p.light}`}>
              <span class="dot" />
              {t.light.names[p.light as keyof typeof t.light.names]}
              <span class="place-time" data-light-today={p.light} />
            </span>
            <div class="place-body">
              <h3>{p.name}</h3>
              <p>{p.note}</p>
              <button class="place-book" type="button" data-open-booking data-light={p.light}>
                {t.places.choose}
              </button>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Brands -->
  {site.showBrands && (
  <section class="section brands" id="brands">
    <div class="wrap head">
      <h2>{t.brands.title}</h2>
      <p class="lead">{t.brands.lead}</p>
    </div>
    <div class="rail rail-reels">
      {
        t.brands.reels.map((r, i) => (
          <figure class="reel">
            <div class={`reel-screen plate plate-${reelLight.at(i)}`}>
              <span class="reel-play" aria-hidden="true" />
            </div>
            <figcaption>{r}</figcaption>
          </figure>
        ))
      }
    </div>
    <div class="wrap">
      <ul class="panel offers">
        {
          t.brands.offers.map((o) => (
            <li class="offer">
              <h3>{o.name}</h3>
              <p class="offer-body">{o.includes}</p>
              <p class="offer-price">{o.price}</p>
            </li>
          ))
        }
      </ul>
      <p class="note">{t.brands.rights}</p>

      <h3 class="steps-title">{t.brands.stepsTitle}</h3>
      <ol class="steps">
        {
          t.brands.steps.map((s) => (
            <li>
              <strong>{s.name}</strong>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
      <a class="button" href={quoteHref}>{t.brands.cta}</a>
    </div>
  </section>
  )}

  <!-- Team -->
  <section class="section" id="team">
    <div class="wrap head">
      <h2>{t.about.title}</h2>
      <p class="lead">{t.about.languages}</p>
    </div>
    <div class="wrap people">
      {
        t.about.people.map((p, i) => (
          <article class="person">
            <div class={`plate ${i ? 'plate-dawn' : 'plate-golden'} portrait`} />
            <h3>{p.name}</h3>
            <p class="role">{p.role}</p>
            <p class="person-body">{p.body}</p>
          </article>
        ))
      }
      <aside class="name-story">
        <p class="name-words" aria-hidden="true">
          <span>lumière</span>
          <span lang="fa" dir="rtl">نور</span>
        </p>
        <h3>{t.about.nameTitle}</h3>
        <p>{t.about.nameBody}</p>
      </aside>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section wrap faq" id="faq">
    <h2>{t.faq.title}</h2>
    <div class="panel faq-list">
      {
        t.faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Contact -->
  <section class="contact" id="contact">
    <div class="contact-glow" aria-hidden="true"></div>
    <img class="contact-mark" src="/brand/luminoor-logo.png" alt="" aria-hidden="true" width="556" height="166" loading="lazy" />
    <div class="wrap">
      <h2>{t.contact.title}</h2>
      <p class="lead">{t.contact.lead}</p>
      <div class="hero-actions">
        <button class="button" type="button" data-open-booking>{t.hero.cta}</button>
        <a class="button ghost" href={`mailto:${site.email}`}>{t.contact.email}</a>
        <a class="button ghost" href={site.instagram} rel="noopener">{t.contact.instagram}</a>
        {site.whatsapp && <a class="button ghost" href={site.whatsapp} rel="noopener">{t.contact.whatsapp}</a>}
      </div>
    </div>
  </section>
</main>

<nav class="wrap guides" aria-label={landingUi[t.lang].guides}>
  <p>{landingUi[t.lang].guides}</p>
  <ul>
    {
      landingIds.map((id) => (
        <li>
          <a href={landingHref(id, t.lang)}>{landings[id][t.lang].h1}</a>
        </li>
      ))
    }
  </ul>
</nav>

<footer class="wrap foot">
  <Logo href={home} size="footer" />
  <p>© {new Date().getFullYear()} Luminoor, {site.city}. {t.footer.rights}</p>
  <a href={t.footer.legalHref}>{t.footer.legal}</a>
</footer>

<!-- App-style tab bar on phones -->
<nav class="tabbar" aria-label={t.nav.home}>
  <a href="#top" data-tab="top">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="4"></circle><path d="M3 17h18M12 4v2M5.6 7.6l1.4 1.4M18.4 7.6 17 9"></path></svg>
    <span>{t.nav.home}</span>
  </a>
  <a href="#sessions" data-tab="sessions">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="3"></rect><circle cx="12" cy="13.5" r="3.5"></circle><path d="M8.5 7l1.5-3h4l1.5 3"></path></svg>
    <span>{t.nav.sessions}</span>
  </a>
  <button type="button" class="tab-book" data-open-booking>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="3"></rect><path d="M4 10h16M9 3v4M15 3v4"></path></svg>
    <span>{t.nav.book}</span>
  </button>
  <a href="#places" data-tab="places">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0 1 13 0c0 4.8-6.5 11-6.5 11Z"></path><circle cx="12" cy="10" r="2.3"></circle></svg>
    <span>{t.nav.places}</span>
  </a>
  <a href="#contact" data-tab="contact">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2.5"></rect><path d="m4 7.5 8 6 8-6"></path></svg>
    <span>{t.nav.contact}</span>
  </a>
</nav>

<Booking t={t} />
<LanguageGate lang={t.lang} />
<Splash />

<script>
  import '../scripts/home';
</script>

<style>
  /* ---------- Header ---------- */
  .top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    transition: background 0.5s var(--ease);
  }
  .top:global(.scrolled) {
    background: rgb(10 10 10 / 0.6);
    backdrop-filter: blur(18px) saturate(1.2);
    box-shadow: 0 1px 0 var(--line);
  }
  .bar :global(.logo) {
    transition:
      opacity 0.5s var(--ease),
      transform 0.5s var(--ease);
  }
  :global(.top:not(.scrolled)) .bar :global(.logo) {
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 0.9rem;
  }
  .pill {
    display: flex;
    gap: 0.25rem;
    padding: 0.3rem;
    border-radius: 999px;
    background: rgb(240 240 240 / 0.06);
    border: 1px solid var(--line);
    backdrop-filter: blur(16px);
  }
  .pill a {
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--muted);
    transition:
      color 0.3s var(--ease),
      background 0.3s var(--ease);
  }
  .pill a:hover,
  .pill a:global(.current) {
    color: var(--ivory);
    background: rgb(240 240 240 / 0.09);
  }
  .bar-end {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.75rem;
  }
  .langs {
    display: flex;
    padding: 0.2rem;
    border-radius: 999px;
    border: 1px solid var(--line);
  }
  .langs a {
    min-width: 2.2rem;
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    text-align: center;
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--muted);
    transition:
      color 0.3s var(--ease),
      background 0.3s var(--ease);
  }
  .langs a[lang='fa'] {
    font-family: 'Vazirmatn', var(--body);
  }
  .langs a:hover {
    color: var(--ivory);
  }
  .langs a[aria-current] {
    color: #0a0a0a;
    background: var(--metal);
  }
  .bar-book {
    min-height: 2.5rem;
    padding: 0 1.15rem;
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: min(100svh, 64rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 8rem 5rem;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-light {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(38% 42% at 50% 34%, rgb(255 255 255 / 0.055), transparent 70%),
      radial-gradient(80% 55% at 50% 118%, rgb(255 255 255 / 0.035), transparent 70%),
      var(--bg);
  }
  .hero-light::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(6 6 6 / 0.78), transparent 30%, transparent 48%, rgb(6 6 6 / 0.96)),
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='.18'/></svg>");
    opacity: var(--shade, 1);
  }
  /* A warm light behind the logo that breathes slowly */
  .hero-halo {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(56rem, 120vw);
    aspect-ratio: 2 / 1;
    transform: translate(-50%, -12%);
    background: radial-gradient(closest-side, rgb(220 200 170 / 0.14), rgb(220 200 170 / 0.045) 50%, transparent 80%);
    pointer-events: none;
    z-index: -1;
    animation:
      fade-in 2s var(--ease) 1.4s both,
      breathe 7s ease-in-out 3.4s infinite;
    will-change: transform, opacity;
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  @keyframes breathe {
    50% {
      opacity: 0.55;
      transform: translate(-50%, -12%) scale(0.94);
    }
  }
  /* The light that follows the visitor after the opening pass (lib/followLight.ts) */
  .hero-follow {
    position: absolute;
    z-index: -1;
    left: 0;
    top: 0;
    width: min(46rem, 110vw);
    aspect-ratio: 1;
    margin: calc(min(46rem, 110vw) / -2) 0 0 calc(min(46rem, 110vw) / -2);
    background: radial-gradient(
      closest-side,
      rgb(236 222 198 / 0.11),
      rgb(225 205 175 / 0.05) 45%,
      transparent 100%
    );
    opacity: 0;
    pointer-events: none;
    will-change: transform, opacity;
  }
  /* The Eiffel Tower behind the logo, out of focus like a distant background, dissolving towards the bottom */
  .hero-eiffel {
    position: absolute;
    z-index: -1;
    left: 50%;
    bottom: 3%;
    height: 78%;
    aspect-ratio: 1 / 2;
    transform: translateX(-50%);
    color: #e6d6bd;
    opacity: 0.1;
    filter: blur(6px) drop-shadow(0 0 30px rgb(230 214 189 / 0.2));
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 50%, transparent 98%);
    mask-image: linear-gradient(180deg, #000 0%, #000 50%, transparent 98%);
    pointer-events: none;
    animation: fade-in 2.4s var(--ease) 0.4s both;
  }
  .hero-inner {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  /* The logo, lit once by a passing light (LightLogo, driven by scripts/home.ts) */
  .hero :global(.hero-mark) {
    width: clamp(13rem, 30vw, 24rem);
  }
  /* the name of the style, small under the logo */
  .hero-kicker {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.5rem;
    font-family: 'Jost', system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: #e6d6bd;
    animation: enter 1.4s var(--ease) 1.2s both;
  }
  .hero-kicker span {
    margin-inline-end: -0.42em;
  }
  .hero-kicker::before,
  .hero-kicker::after {
    content: '';
    width: 2.2rem;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
  }
  h1 {
    text-wrap: balance;
    margin-top: clamp(2rem, 5vh, 3rem);
    font-size: clamp(1.9rem, 4.2vw, 3.9rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    max-width: 16em;
    padding-block: 0.08em;
    background: var(--champagne-foil);
    background-size: 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    animation:
      enter 1.4s var(--ease) 1.2s both,
      foil 7s ease-in-out 2.6s 1;
  }
  /* French and English: engraved Roman capitals (Persian keeps Reem Kufi) */
  :global(:root:not([lang='fa'])) h1 {
    font-family: 'Cinzel', serif;
    font-weight: 400;
    font-size: clamp(1.85rem, 3.3vw, 3.1rem);
    line-height: 1.25;
    letter-spacing: 0.04em;
    max-width: 22em;
  }
  /* Light travelling once across the gold (an endless shimmer repaints the title every frame) */
  @keyframes foil {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }
  .hero-lead {
    text-wrap: balance;
    margin-top: 1.5rem;
    font-size: 1.1rem;
    max-width: 30em;
    color: rgb(240 240 240 / 0.78);
    animation: enter 1.4s var(--ease) 1.35s both;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .hero .hero-actions {
    justify-content: center;
    animation: enter 1.4s var(--ease) 1.5s both;
  }
  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Sections ---------- */
  .section {
    padding-top: clamp(6rem, 13vw, 11rem);
  }
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 1rem 3rem;
    align-items: end;
    margin-bottom: clamp(2.25rem, 5vw, 4rem);
  }
  /* How it works: three frames, each in a viewfinder's corner marks */
  .how {
    list-style: none;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .how li {
    --c: rgb(230 214 189 / 0.55);
    position: relative;
    padding: 2rem 1.75rem 2.1rem;
    border-radius: 6px;
    background:
      linear-gradient(var(--c), var(--c)) top left / 1.4rem 1px no-repeat,
