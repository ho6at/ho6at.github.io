---
import Logo from './Logo.astro';
import Booking from './Booking.astro';
import { site } from '../site';
import type fr from '../i18n/fr';

interface Props {
  t: typeof fr;
}
const { t } = Astro.props;
const home = t.lang === 'fr' ? '/' : '/en/';
const quoteHref = `mailto:${site.email}?subject=${encodeURIComponent(t.brands.quoteSubject)}`;
const packageLight = { essentiel: 'day', signature: 'golden', lumiere: 'blue' } as Record<string, string>;
const reelLight = ['golden', 'dawn', 'day', 'night'];
const strings = {
  names: t.light.names,
  moods: t.light.moods,
  locale: t.locale,
  email: site.email,
  whatsapp: site.whatsapp,
  subject: t.sessions.subject,
  message: t.sessions.message,
  around: t.sessions.around,
  packages: t.sessions.packages,
  stepOf: t.sessions.stepOf,
  steps: t.sessions.steps,
};
---

<header class="top" data-top>
  <div class="wrap bar">
    <Logo href={home} rise />
    <nav class="pill" aria-label="Main">
      <a href="#sessions">{t.nav.sessions}</a>
      <a href="#places">{t.nav.places}</a>
      <a href="#brands">{t.nav.brands}</a>
      <a href="#team">{t.nav.about}</a>
      <a href="#contact">{t.nav.contact}</a>
    </nav>
    <div class="bar-end">
      <a class="lang" href={t.nav.switchHref} hreflang={t.lang === 'fr' ? 'en' : 'fr'} aria-label={t.nav.switchName}
        >{t.nav.switchLabel}</a
      >
      <button class="button bar-book" type="button" data-open-booking>{t.nav.book}</button>
    </div>
  </div>
</header>

<main id="top" data-strings={JSON.stringify(strings)}>
  <!-- Hero: a dark scene lit by the light of the chosen hour in Paris -->
  <section class="hero" data-hero>
    <div class="hero-light" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="badge status" aria-live="polite">
        <span class="dot live-dot"></span>
        {t.light.now}&nbsp;<strong data-clock>--:--</strong>&nbsp;·&nbsp;<span data-live-phase></span>
      </p>
      <h1>{t.hero.title}</h1>
      <p class="hero-lead">{t.hero.lead}</p>
      <div class="hero-actions">
        <button class="button" type="button" data-open-booking>{t.hero.cta}</button>
        <a class="button ghost" href="#brands">{t.hero.ctaSecondary}</a>
      </div>
    </div>

    <div class="wrap scrub-wrap">
      <div class="scrub-track" data-track>
        <div class="ticks" data-ticks aria-hidden="true"></div>
        <span class="marker" data-tick="sunrise" aria-hidden="true"><i></i><span>{t.light.sunrise}</span> <time></time></span>
        <span class="marker" data-tick="sunset" aria-hidden="true"><i></i><span>{t.light.sunset}</span> <time></time></span>
        <span class="knob" data-sun aria-hidden="true">
          <span class="knob-label" data-knob-label><span data-dial-name></span> <strong data-dial-time></strong></span>
        </span>
        <input type="range" min="0" max="1000" step="1" value="700" data-dial aria-label={t.light.dialLabel} />
      </div>
      <p class="scrub-mood"><span data-dial-mood></span> <span class="scrub-hint">{t.light.hint}</span></p>
    </div>
  </section>

  <!-- Sessions -->
  <section class="section" id="sessions">
    <div class="wrap head">
      <h2>{t.sessions.title}</h2>
      <p class="lead">{t.sessions.lead}</p>
    </div>
    <div class="rail rail-3">
      {
        t.sessions.packages.map((p) => (
          <article class="card pkg">
            <div class={`plate plate-${packageLight[p.id]} pkg-plate`}>
              <span class={`badge dot-${packageLight[p.id]}`}>
                <span class="dot" />
                {t.light.names[packageLight[p.id] as keyof typeof t.light.names]}
              </span>
            </div>
            <div class="card-body">
              <div class="pkg-top">
                <h3>{p.name}</h3>
                <p class="pkg-price">
                  {p.price} €<span>{t.sessions.from}</span>
                </p>
              </div>
              <p class="pkg-meta">
                {p.duration} · {p.places}
              </p>
              <p class="pkg-body">{p.includes}</p>
              <button class="button ghost pkg-choose" type="button" data-open-booking data-package={p.id}>
                {t.sessions.choose}
              </button>
            </div>
          </article>
        ))
      }
    </div>
    <p class="wrap note">{t.sessions.extras}</p>
  </section>

  <!-- Places -->
  <section class="section" id="places">
    <div class="wrap head">
      <h2>{t.places.title}</h2>
      <p class="lead">{t.places.lead}</p>
    </div>
    <div class="rail rail-places">
      {
        t.places.items.map((p) => (
          <article class={`place plate plate-${p.light}`}>
            <span class={`badge dot-${p.light}`}>
              <span class="dot" />
              {t.light.names[p.light as keyof typeof t.light.names]}
              <span class="place-time" data-light-today={p.light} />
            </span>
            <div class="place-body">
              <h3>{p.name}</h3>
              <p>{p.note}</p>
              <button class="place-book" type="button" data-open-booking data-light={p.light}>
                {t.places.choose}
              </button>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Brands -->
  <section class="section brands" id="brands">
    <div class="wrap head">
      <h2>{t.brands.title}</h2>
      <p class="lead">{t.brands.lead}</p>
    </div>
    <div class="rail rail-reels">
      {
        t.brands.reels.map((r, i) => (
          <figure class="reel">
            <div class={`reel-screen plate plate-${reelLight.at(i)}`}>
              <span class="reel-play" aria-hidden="true" />
            </div>
            <figcaption>{r}</figcaption>
          </figure>
        ))
      }
    </div>
    <div class="wrap">
      <ul class="panel offers">
        {
          t.brands.offers.map((o) => (
            <li class="offer">
              <h3>{o.name}</h3>
              <p class="offer-body">{o.includes}</p>
              <p class="offer-price">{o.price}</p>
            </li>
          ))
        }
      </ul>
      <p class="note">{t.brands.rights}</p>

      <h3 class="steps-title">{t.brands.stepsTitle}</h3>
      <ol class="steps">
        {
          t.brands.steps.map((s) => (
            <li>
              <strong>{s.name}</strong>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
      <a class="button" href={quoteHref}>{t.brands.cta}</a>
    </div>
  </section>

  <!-- Team -->
  <section class="section" id="team">
    <div class="wrap head">
      <h2>{t.about.title}</h2>
      <p class="lead">{t.about.languages}</p>
    </div>
    <div class="wrap people">
      {
        t.about.people.map((p, i) => (
          <article class="person">
            <div class={`plate ${i ? 'plate-dawn' : 'plate-golden'} portrait`} />
            <h3>{p.name}</h3>
            <p class="role">{p.role}</p>
            <p class="person-body">{p.body}</p>
          </article>
        ))
      }
      <aside class="name-story">
        <p class="name-words" aria-hidden="true">
          <span>lumière</span>
          <span lang="fa" dir="rtl">نور</span>
        </p>
        <h3>{t.about.nameTitle}</h3>
        <p>{t.about.nameBody}</p>
      </aside>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section wrap faq" id="faq">
    <h2>{t.faq.title}</h2>
    <div class="panel faq-list">
      {
        t.faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Contact -->
  <section class="contact" id="contact">
    <div class="contact-glow" aria-hidden="true"></div>
    <div class="wrap">
      <h2>{t.contact.title}</h2>
      <p class="lead">{t.contact.lead}</p>
      <div class="hero-actions">
        <button class="button" type="button" data-open-booking>{t.hero.cta}</button>
        <a class="button ghost" href={`mailto:${site.email}`}>{t.contact.email}</a>
        <a class="button ghost" href={site.instagram} rel="noopener">{t.contact.instagram}</a>
        {site.whatsapp && <a class="button ghost" href={site.whatsapp} rel="noopener">{t.contact.whatsapp}</a>}
      </div>
    </div>
  </section>
</main>

<footer class="wrap foot">
  <Logo href={home} />
  <p>© {new Date().getFullYear()} Luminoor, {site.city}. {t.footer.rights}</p>
  <a href={t.footer.legalHref}>{t.footer.legal}</a>
</footer>

<!-- App-style tab bar on phones -->
<nav class="tabbar" aria-label={t.nav.home}>
  <a href="#top" data-tab="top">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="4"></circle><path d="M3 17h18M12 4v2M5.6 7.6l1.4 1.4M18.4 7.6 17 9"></path></svg>
    <span>{t.nav.home}</span>
  </a>
  <a href="#sessions" data-tab="sessions">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="3"></rect><circle cx="12" cy="13.5" r="3.5"></circle><path d="M8.5 7l1.5-3h4l1.5 3"></path></svg>
    <span>{t.nav.sessions}</span>
  </a>
  <button type="button" class="tab-book" data-open-booking>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="3"></rect><path d="M4 10h16M9 3v4M15 3v4"></path></svg>
    <span>{t.nav.book}</span>
  </button>
  <a href="#places" data-tab="places">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0 1 13 0c0 4.8-6.5 11-6.5 11Z"></path><circle cx="12" cy="10" r="2.3"></circle></svg>
    <span>{t.nav.places}</span>
  </a>
  <a href="#brands" data-tab="brands">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2.5"></rect><path d="m11 9.5 3 2.5-3 2.5Z"></path></svg>
    <span>{t.nav.brands}</span>
  </a>
</nav>

<Booking t={t} />

<script>
  import '../scripts/home';
</script>

<style>
  /* ---------- Header ---------- */
  .top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    transition: background 0.5s var(--ease);
  }
  .top:global(.scrolled) {
    background: rgb(13 12 11 / 0.6);
    backdrop-filter: blur(18px) saturate(1.2);
    box-shadow: 0 1px 0 var(--line);
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 0.9rem;
  }
  .pill {
    display: flex;
    gap: 0.25rem;
    padding: 0.3rem;
    border-radius: 999px;
    background: rgb(236 228 214 / 0.06);
    border: 1px solid var(--line);
    backdrop-filter: blur(16px);
  }
  .pill a {
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--muted);
    transition:
      color 0.3s var(--ease),
      background 0.3s var(--ease);
  }
  .pill a:hover,
  .pill a:global(.current) {
    color: var(--ivory);
    background: rgb(236 228 214 / 0.09);
  }
  .bar-end {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.75rem;
  }
  .lang {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--muted);
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--line);
  }
  .lang:hover {
    color: var(--ivory);
  }
  .bar-book {
    min-height: 2.5rem;
    padding: 0 1.15rem;
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: min(100svh, 64rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: 7rem 2rem;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-light {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at var(--sun-x, 70%) var(--sun-y, 60%), var(--glow-core, #ffe6b8) 0, transparent 6%),
      radial-gradient(
        46% 58% at var(--sun-x, 70%) var(--sun-y, 60%),
        color-mix(in srgb, var(--glow-a, #e6a95a) 72%, transparent),
        transparent 72%
      ),
      radial-gradient(130% 70% at 50% 115%, color-mix(in srgb, var(--glow-b, #5a3b1c) 55%, transparent), transparent 70%),
      var(--bg);
  }
  .hero-light::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(13 12 11 / 0.6), transparent 28%, transparent 50%, rgb(13 12 11 / 0.92)),
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='.3'/></svg>");
    opacity: var(--shade, 1);
  }
  .status {
    margin-bottom: 2rem;
    font-weight: 500;
  }
  .status strong {
    font-variant-numeric: tabular-nums;
  }
  .live-dot {
    animation: breathe 2.8s ease-in-out infinite;
  }
  @keyframes breathe {
    50% {
      opacity: 0.4;
    }
  }
  h1 {
    font-size: clamp(3rem, 8.4vw, 8.25rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    max-width: 10.5em;
    animation: enter 1.4s var(--ease) 0.25s both;
  }
  .hero-lead {
    margin-top: 2.75rem;
    font-size: 1.15rem;
    max-width: 30em;
    color: rgb(236 228 214 / 0.78);
    animation: enter 1.4s var(--ease) 0.45s both;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .hero .hero-actions {
    animation: enter 1.4s var(--ease) 0.6s both;
  }
  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  /* Time scrubber */
  .scrub-wrap {
    margin-top: clamp(4rem, 10vh, 6.5rem);
  }
  .scrub-track {
    position: relative;
    height: 3.25rem;
  }
  .ticks {
    position: absolute;
    inset: 0;
  }
  .ticks :global(i) {
    position: absolute;
    bottom: 1.2rem;
    width: 1px;
    height: 0.5rem;
    background: rgb(236 228 214 / 0.22);
  }
  .ticks :global(i.hour) {
    height: 0.95rem;
    background: rgb(236 228 214 / 0.5);
  }
  .ticks :global(b) {
    position: absolute;
    bottom: 0;
    transform: translateX(-50%);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .scrub-track::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.2rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--line-strong) 6%, var(--line-strong) 94%, transparent);
  }
  .marker {
    position: absolute;
    bottom: 2.5rem;
    transform: translateX(-50%);
    font-size: 0.72rem;
    color: var(--muted);
    white-space: nowrap;
    display: flex;
    gap: 0.3rem;
    align-items: center;
    transition: opacity 0.3s var(--ease);
  }
  .marker:global(.hidden) {
    opacity: 0;
  }
  .marker time {
    color: var(--ivory);
    font-weight: 600;
  }
  .marker i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    border: 1px solid var(--gold);
  }
  .knob {
    position: absolute;
    bottom: 1.2rem;
    width: 1.3rem;
    height: 1.3rem;
    margin: 0 0 -0.65rem -0.65rem;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #fff3d6, var(--gold) 70%);
    box-shadow:
      0 0 0 6px rgb(201 169 107 / 0.18),
      0 0 28px 6px rgb(230 180 100 / 0.45);
    pointer-events: none;
  }
  .scrub-track:has(input:focus-visible) .knob {
    outline: 2px solid var(--ivory);
    outline-offset: 5px;
  }
  .knob-label {
    position: absolute;
    bottom: calc(100% + 0.8rem);
    left: 50%;
    transform: translateX(var(--label-shift, -50%));
    white-space: nowrap;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: rgb(22 20 18 / 0.6);
    border: 1px solid var(--line-strong);
    backdrop-filter: blur(16px);
    font-size: 0.85rem;
    font-weight: 600;
    transition: transform 0.3s var(--ease);
  }
  .scrub-track:hover .knob-label,
  .scrub-track:has(input:active) .knob-label {
    transform: translateX(var(--label-shift, -50%)) translateY(-3px);
  }
  .knob-label strong {
    font-family: var(--display);
    font-weight: 300;
    font-size: 1.05rem;
    margin-left: 0.2rem;
    color: var(--gold-soft);
    font-variant-numeric: tabular-nums;
  }
  .scrub-track input {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 4.5rem;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
  }
  .scrub-mood {
    margin-top: 0.9rem;
    font-size: 0.9rem;
    color: rgb(236 228 214 / 0.78);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }
  .scrub-hint {
    color: var(--muted);
  }

  /* ---------- Sections ---------- */
  .section {
    padding-top: clamp(6rem, 13vw, 11rem);
  }
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 1rem 3rem;
    align-items: end;
    margin-bottom: clamp(2.25rem, 5vw, 4rem);
  }
  .note {
    margin-top: 1.75rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .panel {
    list-style: none;
    margin: 0;
    padding: 0.5rem 1.75rem;
    border-radius: var(--radius);
    background: linear-gradient(180deg, rgb(236 228 214 / 0.05), rgb(236 228 214 / 0.015));
    border: 1px solid var(--line);
  }

  /* Rails: grids on desktop, swipeable on phones */
  .rail {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .rail-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .rail-places {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .rail-reels {
    grid-template-columns: repeat(4, minmax(0, 15rem));
  }

  /* Package cards */
  .card {
    border-radius: calc(var(--radius) + 4px);
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.6s var(--ease),
      border-color 0.6s var(--ease);
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--line-strong);
  }
  .pkg-plate {
    aspect-ratio: 4 / 3;
    border-radius: 0;
    padding: 1rem;
  }
  .pkg-plate .badge {
    position: relative;
    z-index: 2;
  }
  .card-body {
    padding: 1.5rem 1.5rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }
  .pkg-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .pkg h3 {
    font-size: 2rem;
  }
  .pkg-price {
    font-family: var(--display);
    font-size: 1.75rem;
    white-space: nowrap;
    color: var(--gold-soft);
  }
  .pkg-price span {
    font-family: var(--body);
    font-size: 0.72rem;
    color: var(--muted);
    margin-left: 0.35rem;
  }
  .pkg-meta {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .pkg-body {
    flex: 1;
  }
  .pkg-choose {
    margin-top: 0.75rem;
    width: 100%;
  }

  /* Place cards */
  .place {
    aspect-ratio: 3 / 4.4;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.6s var(--ease);
  }
  .place:hover {
    transform: translateY(-4px);
  }
  .place > * {
    position: relative;
    z-index: 2;
  }
  .place .badge {
    align-self: flex-start;
  }
  .place-time {
    color: var(--muted);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .place-body::before {
    content: '';
    position: absolute;
    inset: -5rem -1rem -1rem;
    z-index: -1;
    background: linear-gradient(180deg, transparent, rgb(7 6 5 / 0.8) 60%);
    border-radius: 0 0 var(--radius) var(--radius);
  }
  .place h3 {
    font-size: 1.6rem;
  }
  .place-body p {
    font-size: 0.875rem;
    color: rgb(236 228 214 / 0.75);
    margin-top: 0.35rem;
  }
  .place-book {
    margin-top: 0.85rem;
