---
import Logo from './Logo.astro';
import Booking from './Booking.astro';
import LanguageGate from './LanguageGate.astro';
import { site } from '../site';
import type fr from '../i18n/fr';

interface Props {
  t: typeof fr;
}
const { t } = Astro.props;
const home = t.lang === 'fr' ? '/' : '/en/';
const quoteHref = `mailto:${site.email}?subject=${encodeURIComponent(t.brands.quoteSubject)}`;
const packageLight = { minimal: 'day', classic: 'dawn', signature: 'golden', cinestyle: 'blue' } as Record<string, string>;
const reelLight = ['golden', 'dawn', 'day', 'night'];
const strings = {
  names: t.light.names,
  locale: t.locale,
  email: site.email,
  whatsapp: site.whatsapp,
  subject: t.sessions.subject,
  message: t.sessions.message,
  around: t.sessions.around,
  packages: t.sessions.packages,
  stepOf: t.sessions.stepOf,
  steps: t.sessions.steps,
};
---

<header class="top" data-top>
  <div class="wrap bar">
    <Logo href={home} />
    <nav class="pill" aria-label="Main">
      <a href="#sessions">{t.nav.sessions}</a>
      <a href="#places">{t.nav.places}</a>
      <a href="#brands">{t.nav.brands}</a>
      <a href="#team">{t.nav.about}</a>
      <a href="#contact">{t.nav.contact}</a>
    </nav>
    <div class="bar-end">
      <a class="lang" href={t.nav.switchHref} hreflang={t.lang === 'fr' ? 'en' : 'fr'} aria-label={t.nav.switchName}
        >{t.nav.switchLabel}</a
      >
      <button class="button bar-book" type="button" data-open-booking>{t.nav.book}</button>
    </div>
  </div>
</header>

<main id="top" data-strings={JSON.stringify(strings)}>
  <!-- Hero: the Luminoor Paris logo under a soft studio light -->
  <section class="hero" data-hero>
    <div class="hero-light" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <div class="hero-mark" aria-hidden="true">
        <picture>
          <source srcset="/brand/luminoor-logo.webp" type="image/webp" />
          <img src="/brand/luminoor-logo.png" alt="" width="556" height="166" fetchpriority="high" />
        </picture>
      </div>
      <h1><span class="sr-only">Luminoor Paris. </span>{t.hero.title}</h1>
      <p class="hero-lead">{t.hero.lead}</p>
      <div class="hero-actions">
        <button class="button" type="button" data-open-booking>{t.hero.cta}</button>
        <a class="button ghost" href="#brands">{t.hero.ctaSecondary}</a>
      </div>
    </div>

  </section>

  <!-- Sessions -->
  <section class="section" id="sessions">
    <div class="wrap head">
      <h2>{t.sessions.title}</h2>
      <p class="lead">{t.sessions.lead}</p>
    </div>
    <div class="rail rail-4">
      {
        t.sessions.packages.map((p) => (
          <article class:list={['card pkg', { featured: p.featured }]}>
            <div class={`plate plate-${packageLight[p.id]} pkg-plate`}>
              <span class="pkg-duration">{p.duration}</span>
              {p.featured && <span class="pkg-flag">{t.sessions.featuredLabel}</span>}
            </div>
            <div class="card-body">
              <div class="pkg-top">
                <h3>{p.name}</h3>
                <p class="pkg-price">{p.price} €</p>
              </div>
              <ul class="pkg-list">
                <li>
                  {p.places}
                  {p.placesNote && <span>{p.placesNote}</span>}
                </li>
                <li>{p.photos}</li>
                {p.bonus && <li class="pkg-bonus">{p.bonus}</li>}
                <li>{p.style}</li>
              </ul>
              <p class="pkg-best">
                <span>{t.sessions.bestForLabel}</span> {p.bestFor}
              </p>
              <button class="button ghost pkg-choose" type="button" data-open-booking data-package={p.id}>
                {t.sessions.choose}
              </button>
            </div>
          </article>
        ))
      }
    </div>
    <p class="wrap note">{t.sessions.extras}</p>
  </section>

  <!-- Places -->
  <section class="section" id="places">
    <div class="wrap head">
      <h2>{t.places.title}</h2>
      <p class="lead">{t.places.lead}</p>
    </div>
    <div class="rail rail-places">
      {
        t.places.items.map((p) => (
          <article class={`place plate plate-${p.light}`}>
            <span class={`badge dot-${p.light}`}>
              <span class="dot" />
              {t.light.names[p.light as keyof typeof t.light.names]}
              <span class="place-time" data-light-today={p.light} />
            </span>
            <div class="place-body">
              <h3>{p.name}</h3>
              <p>{p.note}</p>
              <button class="place-book" type="button" data-open-booking data-light={p.light}>
                {t.places.choose}
              </button>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Brands -->
  <section class="section brands" id="brands">
    <div class="wrap head">
      <h2>{t.brands.title}</h2>
      <p class="lead">{t.brands.lead}</p>
    </div>
    <div class="rail rail-reels">
      {
        t.brands.reels.map((r, i) => (
          <figure class="reel">
            <div class={`reel-screen plate plate-${reelLight.at(i)}`}>
              <span class="reel-play" aria-hidden="true" />
            </div>
            <figcaption>{r}</figcaption>
          </figure>
        ))
      }
    </div>
    <div class="wrap">
      <ul class="panel offers">
        {
          t.brands.offers.map((o) => (
            <li class="offer">
              <h3>{o.name}</h3>
              <p class="offer-body">{o.includes}</p>
              <p class="offer-price">{o.price}</p>
            </li>
          ))
        }
      </ul>
      <p class="note">{t.brands.rights}</p>

      <h3 class="steps-title">{t.brands.stepsTitle}</h3>
      <ol class="steps">
        {
          t.brands.steps.map((s) => (
            <li>
              <strong>{s.name}</strong>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
      <a class="button" href={quoteHref}>{t.brands.cta}</a>
    </div>
  </section>

  <!-- Team -->
  <section class="section" id="team">
    <div class="wrap head">
      <h2>{t.about.title}</h2>
      <p class="lead">{t.about.languages}</p>
    </div>
    <div class="wrap people">
      {
        t.about.people.map((p, i) => (
          <article class="person">
            <div class={`plate ${i ? 'plate-dawn' : 'plate-golden'} portrait`} />
            <h3>{p.name}</h3>
            <p class="role">{p.role}</p>
            <p class="person-body">{p.body}</p>
          </article>
        ))
      }
      <aside class="name-story">
        <p class="name-words" aria-hidden="true">
          <span>lumière</span>
          <span lang="fa" dir="rtl">نور</span>
        </p>
        <h3>{t.about.nameTitle}</h3>
        <p>{t.about.nameBody}</p>
      </aside>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section wrap faq" id="faq">
    <h2>{t.faq.title}</h2>
    <div class="panel faq-list">
      {
        t.faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Contact -->
  <section class="contact" id="contact">
    <div class="contact-glow" aria-hidden="true"></div>
    <img class="contact-mark" src="/brand/luminoor-logo.png" alt="" aria-hidden="true" width="556" height="166" loading="lazy" />
    <div class="wrap">
      <h2>{t.contact.title}</h2>
      <p class="lead">{t.contact.lead}</p>
      <div class="hero-actions">
        <button class="button" type="button" data-open-booking>{t.hero.cta}</button>
        <a class="button ghost" href={`mailto:${site.email}`}>{t.contact.email}</a>
        <a class="button ghost" href={site.instagram} rel="noopener">{t.contact.instagram}</a>
        {site.whatsapp && <a class="button ghost" href={site.whatsapp} rel="noopener">{t.contact.whatsapp}</a>}
      </div>
    </div>
  </section>
</main>

<footer class="wrap foot">
  <Logo href={home} size="footer" />
  <p>© {new Date().getFullYear()} Luminoor, {site.city}. {t.footer.rights}</p>
  <a href={t.footer.legalHref}>{t.footer.legal}</a>
</footer>

<!-- App-style tab bar on phones -->
<nav class="tabbar" aria-label={t.nav.home}>
  <a href="#top" data-tab="top">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="4"></circle><path d="M3 17h18M12 4v2M5.6 7.6l1.4 1.4M18.4 7.6 17 9"></path></svg>
    <span>{t.nav.home}</span>
  </a>
  <a href="#sessions" data-tab="sessions">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="3"></rect><circle cx="12" cy="13.5" r="3.5"></circle><path d="M8.5 7l1.5-3h4l1.5 3"></path></svg>
    <span>{t.nav.sessions}</span>
  </a>
  <button type="button" class="tab-book" data-open-booking>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="3"></rect><path d="M4 10h16M9 3v4M15 3v4"></path></svg>
    <span>{t.nav.book}</span>
  </button>
  <a href="#places" data-tab="places">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0 1 13 0c0 4.8-6.5 11-6.5 11Z"></path><circle cx="12" cy="10" r="2.3"></circle></svg>
    <span>{t.nav.places}</span>
  </a>
  <a href="#brands" data-tab="brands">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2.5"></rect><path d="m11 9.5 3 2.5-3 2.5Z"></path></svg>
    <span>{t.nav.brands}</span>
  </a>
</nav>

<Booking t={t} />
<LanguageGate lang={t.lang} />

<script>
  import '../scripts/home';
</script>

<style>
  /* ---------- Header ---------- */
  .top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    transition: background 0.5s var(--ease);
  }
  .top:global(.scrolled) {
    background: rgb(10 10 10 / 0.6);
    backdrop-filter: blur(18px) saturate(1.2);
    box-shadow: 0 1px 0 var(--line);
  }
  .bar :global(.logo) {
    transition:
      opacity 0.5s var(--ease),
      transform 0.5s var(--ease);
  }
  :global(.top:not(.scrolled)) .bar :global(.logo) {
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 0.9rem;
  }
  .pill {
    display: flex;
    gap: 0.25rem;
    padding: 0.3rem;
    border-radius: 999px;
    background: rgb(240 240 240 / 0.06);
    border: 1px solid var(--line);
    backdrop-filter: blur(16px);
  }
  .pill a {
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--muted);
    transition:
      color 0.3s var(--ease),
      background 0.3s var(--ease);
  }
  .pill a:hover,
  .pill a:global(.current) {
    color: var(--ivory);
    background: rgb(240 240 240 / 0.09);
  }
  .bar-end {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.75rem;
  }
  .lang {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--muted);
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--line);
  }
  .lang:hover {
    color: var(--ivory);
  }
  .bar-book {
    min-height: 2.5rem;
    padding: 0 1.15rem;
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: min(100svh, 64rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 8rem 5rem;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-light {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(38% 42% at 50% 34%, rgb(255 255 255 / 0.11), transparent 70%),
      radial-gradient(80% 55% at 50% 118%, rgb(255 255 255 / 0.07), transparent 70%),
      var(--bg);
  }
  .hero-light::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(10 10 10 / 0.6), transparent 28%, transparent 50%, rgb(10 10 10 / 0.92)),
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='.3'/></svg>");
    opacity: var(--shade, 1);
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  /* The script logo as the hero's mark: written in once, then a single sheen of light */
  .hero-mark {
    position: relative;
    width: clamp(17rem, 46vw, 40rem);
    filter: drop-shadow(0 18px 40px rgb(0 0 0 / 0.55));
    -webkit-mask-image: linear-gradient(90deg, #000 45%, transparent 55%);
    mask-image: linear-gradient(90deg, #000 45%, transparent 55%);
    -webkit-mask-size: 260% 100%;
    mask-size: 260% 100%;
    animation: write 2.2s cubic-bezier(0.45, 0.05, 0.25, 1) 0.2s both;
  }
  .hero-mark img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero-mark::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 42%, rgb(255 255 255 / 0.95) 50%, transparent 58%) 120% 0 / 260% 100%
      no-repeat;
    -webkit-mask: url('/brand/luminoor-logo.png') center / contain no-repeat;
    mask: url('/brand/luminoor-logo.png') center / contain no-repeat;
    mix-blend-mode: overlay;
    animation: sheen 2.4s var(--ease) 2.4s both;
  }
  @keyframes write {
    from {
      -webkit-mask-position: 100% 0;
      mask-position: 100% 0;
    }
    to {
      -webkit-mask-position: 0% 0;
      mask-position: 0% 0;
    }
  }
  @keyframes sheen {
    from {
      background-position: 120% 0;
    }
    to {
      background-position: -20% 0;
    }
  }
  h1 {
    margin-top: clamp(2rem, 5vh, 3rem);
    font-size: clamp(1.9rem, 4.2vw, 3.9rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    max-width: 16em;
    animation: enter 1.4s var(--ease) 1.2s both;
  }
  .hero-lead {
    margin-top: 1.5rem;
    font-size: 1.1rem;
    max-width: 30em;
    color: rgb(240 240 240 / 0.78);
    animation: enter 1.4s var(--ease) 1.35s both;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .hero .hero-actions {
    justify-content: center;
    animation: enter 1.4s var(--ease) 1.5s both;
  }
  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  /* ---------- Sections ---------- */
  .section {
    padding-top: clamp(6rem, 13vw, 11rem);
  }
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 1rem 3rem;
    align-items: end;
    margin-bottom: clamp(2.25rem, 5vw, 4rem);
  }
  .note {
    margin-top: 1.75rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .panel {
    list-style: none;
    margin: 0;
    padding: 0.5rem 1.75rem;
    border-radius: var(--radius);
    background: linear-gradient(180deg, rgb(240 240 240 / 0.05), rgb(240 240 240 / 0.015));
    border: 1px solid var(--line);
  }

  /* Rails: grids on desktop, swipeable on phones */
  .rail {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .rail-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .rail-places {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .rail-reels {
    grid-template-columns: repeat(4, minmax(0, 15rem));
  }

  /* Package cards */
  .card {
    border-radius: calc(var(--radius) + 4px);
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.6s var(--ease),
      border-color 0.6s var(--ease);
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--line-strong);
  }
  .pkg-plate {
    aspect-ratio: 16 / 10;
    border-radius: 0;
    padding: 1.1rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .pkg-duration {
    position: relative;
    z-index: 2;
  }
  .pkg-flag {
    z-index: 2;
  }
  .pkg-duration {
    white-space: nowrap;
    font-size: 2.6rem;
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .pkg-flag {
    position: absolute;
    bottom: 1.1rem;
    left: 1.25rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: var(--accent);
    color: #0a0a0a;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .pkg.featured {
    border-color: rgb(225 225 225 / 0.55);
    box-shadow: 0 30px 80px -40px rgb(225 225 225 / 0.45);
  }
  .card-body {
    padding: 1.5rem 1.5rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }
  .pkg-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .pkg h3 {
    font-size: 1.85rem;
  }
  .pkg-price {
    font-size: 1.6rem;
    font-weight: 300;
    white-space: nowrap;
    color: var(--accent-soft);
  }
  .pkg-list {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    font-size: 0.95rem;
  }
  .pkg-list li {
    padding-left: 1.1rem;
    position: relative;
  }
  .pkg-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    border: 1px solid var(--accent);
  }
  .pkg-list li span {
    display: block;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .pkg-bonus {
    color: var(--accent-soft);
  }
  .pkg-best {
    flex: 1;
    padding-top: 0.9rem;
    margin-top: 0.4rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    color: var(--muted);
  }
  .pkg-best span {
    display: block;
    color: var(--ivory);
    font-weight: 500;
    margin-bottom: 0.15rem;
  }
  .pkg-choose {
    margin-top: 0.75rem;
    width: 100%;
  }

  /* Place cards */
  .place {
    aspect-ratio: 3 / 4.4;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.6s var(--ease);
  }
  .place:hover {
    transform: translateY(-4px);
  }
  .place > * {
    position: relative;
    z-index: 2;
  }
  .place .badge {
    align-self: flex-start;
  }
  .place-time {
    color: var(--muted);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .place-body::before {
    content: '';
    position: absolute;
    inset: -5rem -1rem -1rem;
    z-index: -1;
    background: linear-gradient(180deg, transparent, rgb(5 5 5 / 0.8) 60%);
    border-radius: 0 0 var(--radius) var(--radius);
  }
  .place h3 {
    font-size: 1.6rem;
  }
  .place-body p {
    font-size: 0.875rem;
    color: rgb(240 240 240 / 0.75);
    margin-top: 0.35rem;
  }
  .place-book {
    margin-top: 0.85rem;
    background: none;
    border: 0;
    padding: 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-soft);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
    text-align: left;
  }

  /* ---------- Brands ---------- */
  .reel {
    margin: 0;
  }
  .reel:nth-child(even) {
    margin-top: 2.5rem;
  }
  .reel-screen {
    aspect-ratio: 9 / 16;
    border-radius: 1.75rem;
    box-shadow:
      0 0 0 6px #050505,
      0 0 0 7px rgb(240 240 240 / 0.14),
      0 30px 60px -20px rgb(0 0 0 / 0.7);
    display: grid;
    place-items: center;
    transition: transform 0.6s var(--ease);
  }
  .reel:hover .reel-screen {
    transform: translateY(-6px);
  }
  .reel-play {
    position: relative;
    z-index: 2;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: rgb(240 240 240 / 0.16);
    border: 1px solid rgb(240 240 240 / 0.3);
    backdrop-filter: blur(10px);
  }
