---
// Opening splash, once per visit: the whole logo, dimmed, with a strong band of warm light sweeping
// across it while the page loads (the logo is near-white silver, so it is dimmed for the light to show). It closes once the page has loaded and the light has passed at least once.
// The <html> gets the `splash` class from an inline script in Base.astro (skipped for reduced motion or
// a repeat in the same visit; that script also clears it after a few seconds whatever happens).
---

<div class="splash" data-splash aria-hidden="true">
  <div class="splash-logo">
    <img src="/brand/luminoor-logo.png" alt="" width="556" height="166" />
    <span class="splash-light"></span>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const splash = document.querySelector('[data-splash]');
    if (!root.classList.contains('splash') || !splash) return;

    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      try {
        sessionStorage.setItem('luminoor-splash', '1');
      } catch {}
      splash.classList.add('leaving');
      setTimeout(() => {
        root.classList.remove('splash');
        // The hero's entrance played under the splash; play it again unless the language picker is up
        // (the picker replays it when it closes).
        if (!root.classList.contains('ask-lang')) {
          document.querySelectorAll('.hero-mark, .hero h1, .hero-lead, .hero .hero-actions').forEach((el) => {
            el.style.animation = 'none';
            void el.offsetWidth;
            el.style.animation = '';
          });
        }
      }, 650);
    };
    splash.addEventListener('click', finish);

    // Close once the page has loaded and the light has crossed the logo at least once.
    const minimum = new Promise((resolve) => setTimeout(resolve, 2100));
    const loaded = new Promise((resolve) =>
      document.readyState === 'complete' ? resolve() : addEventListener('load', resolve, { once: true }),
    );
    Promise.all([minimum, loaded]).then(finish);
    setTimeout(finish, 6000); // never hold the page longer than this
  })();
</script>

<style>
  .splash {
    display: none;
  }
  :global(html.splash) {
    overflow: hidden;
  }
  :global(html.splash) .splash {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background: var(--bg);
    cursor: pointer;
    transition: opacity 0.65s var(--ease);
  }
  /* A warm glow behind the logo that swells as each band of light passes */
  :global(html.splash) .splash::before {
    content: '';
    position: absolute;
    width: min(110vw, 46rem);
    aspect-ratio: 2 / 1;
    background: radial-gradient(closest-side, rgb(236 196 116 / 0.3), rgb(236 196 116 / 0.08) 55%, transparent 75%);
    filter: blur(6px);
    animation: glow 1.6s ease-in-out infinite;
  }
  .splash.leaving {
    opacity: 0;
  }
  .splash-logo {
    position: relative;
    width: min(78vw, 30rem);
    animation: logo-in 0.8s var(--ease) both;
  }
  .splash-logo img {
    display: block;
    width: 100%;
    height: auto;
    filter: brightness(0.42) drop-shadow(0 12px 30px rgb(0 0 0 / 0.6));
  }
  /* The light: a bright warm band, cut to the shape of the logo, crossing it from left to right */
  .splash-light {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        105deg,
        transparent 38%,
        rgb(240 196 110 / 0.7) 44%,
        rgb(255 248 228 / 1) 50%,
        rgb(240 196 110 / 0.7) 56%,
        transparent 62%
      )
      0 0 / 300% 100% no-repeat;
    -webkit-mask: url('/brand/luminoor-logo.png') center / 100% 100% no-repeat;
    mask: url('/brand/luminoor-logo.png') center / 100% 100% no-repeat;
    filter: drop-shadow(0 0 6px rgb(255 214 140 / 0.9));
    animation: light 1.6s cubic-bezier(0.45, 0.05, 0.25, 1) 0.3s infinite both;
  }
  @keyframes logo-in {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }
  @keyframes light {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0% 0;
    }
  }
  @keyframes glow {
    0%,
    100% {
      opacity: 0.45;
      transform: scale(0.94);
    }
    50% {
      opacity: 1;
      transform: scale(1.04);
    }
  }
</style>
