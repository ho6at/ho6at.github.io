---
// Opening splash, once per visit: the "L" of the logo is written stroke by stroke, then the rest of the
// logo sweeps in and the splash fades away. The <html> gets the `splash` class from an inline script in
// Base.astro (skipped for reduced motion or a repeat in the same visit).
//
// How the writing works: public/brand/luminoor-splash-map.png (made by scripts/splash-map.py) gives every
// pixel of the logo the moment it should appear, as brightness. A filter turns that map into a mask that
// lets through only pixels whose moment has come, and the script below moves that moment forward. Pixels
// where two strokes of the L cross belong to whichever stroke passes there, so crossings stay clean.
---

<div class="splash" data-splash aria-hidden="true">
  <svg class="splash-logo" viewBox="-6 -6 568 178" role="presentation">
    <defs>
      <filter id="splash-threshold" x="0" y="0" width="1" height="1" color-interpolation-filters="sRGB">
        <feComponentTransfer>
          <feFuncR type="linear" slope="36" intercept="-35" data-threshold></feFuncR>
          <feFuncG type="linear" slope="36" intercept="-35" data-threshold></feFuncG>
          <feFuncB type="linear" slope="36" intercept="-35" data-threshold></feFuncB>
        </feComponentTransfer>
      </filter>
      <mask id="splash-reveal" maskUnits="userSpaceOnUse" x="0" y="0" width="556" height="166">
        <image href="/brand/luminoor-splash-map.png" width="556" height="166" filter="url(#splash-threshold)"></image>
      </mask>
    </defs>
    <image href="/brand/luminoor-logo.png" width="556" height="166" mask="url(#splash-reveal)"></image>
  </svg>
</div>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const splash = document.querySelector('[data-splash]');
    if (!root.classList.contains('splash') || !splash) return;
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      try {
        sessionStorage.setItem('luminoor-splash', '1');
      } catch {}
      splash.classList.add('leaving');
      setTimeout(() => {
        root.classList.remove('splash');
        // The hero's entrance played under the splash; play it again unless the language picker is up
        // (the picker replays it when it closes).
        if (!root.classList.contains('ask-lang')) {
          document.querySelectorAll('.hero-mark, .hero h1, .hero-lead, .hero .hero-actions').forEach((el) => {
            el.style.animation = 'none';
            void el.offsetWidth;
            el.style.animation = '';
          });
        }
      }, 650);
    };
    splash.addEventListener('click', finish);

    // Move the reveal moment forward: the L over the first 70% of the map (2 s), the rest of the word
    // over the last 30% (0.9 s). Each pixel shows once its moment has passed, with a soft pen tip.
    const funcs = splash.querySelectorAll('[data-threshold]');
    const slope = 36;
    const ease = (x) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
    const phases = [
      { from: 0, to: 0.7, ms: 2000 },
      { from: 0.7, to: 1, ms: 900 },
    ];
    const total = phases.reduce((sum, p) => sum + p.ms, 0);
    const delay = 250;
    const start = performance.now() + delay;
    const frame = (now) => {
      let elapsed = Math.max(0, now - start);
      let progress = 1;
      for (const p of phases) {
        if (elapsed < p.ms) {
          progress = p.from + (p.to - p.from) * ease(elapsed / p.ms);
          break;
        }
        elapsed -= p.ms;
      }
      const intercept = String(1 - slope * (1 - progress));
      funcs.forEach((f) => f.setAttribute('intercept', intercept));
      if (now - start < total) requestAnimationFrame(frame);
      else setTimeout(finish, 350);
    };
    requestAnimationFrame(frame);
    setTimeout(finish, delay + total + 1500); // safety net if frames are throttled
  })();
</script>

<style>
  .splash {
    display: none;
  }
  :global(html.splash) {
    overflow: hidden;
  }
  :global(html.splash) .splash {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background:
      radial-gradient(40% 40% at 50% 50%, rgb(226 182 96 / 0.12), transparent 70%),
      var(--bg);
    cursor: pointer;
    transition: opacity 0.65s var(--ease);
  }
  .splash.leaving {
    opacity: 0;
  }
  .splash-logo {
    width: min(78vw, 30rem);
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 12px 30px rgb(0 0 0 / 0.6));
  }

</style>
