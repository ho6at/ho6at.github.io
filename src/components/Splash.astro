---
// Opening splash, once per visit: an unseen light passes over the logo (LightLogo + lib/lightPass.ts),
// repeating until the page has loaded, then the splash fades away. The <html> gets the `splash` class from
// an inline script in Base.astro (skipped for reduced motion or a repeat in the same visit; that script
// also clears it after a few seconds whatever happens).
import LightLogo from './LightLogo.astro';
---

<div class="splash" data-splash aria-hidden="true">
  <LightLogo class="splash-logo" base={0.22} />
</div>

<script>
  import { lightPass } from '../lib/lightPass';

  const root = document.documentElement;
  const splash = document.querySelector<HTMLElement>('[data-splash]');
  if (root.classList.contains('splash') && splash) {
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      try {
        sessionStorage.setItem('luminoor-splash', '1');
      } catch {}
      splash.classList.add('leaving');
      setTimeout(() => {
        root.classList.remove('splash');
        // The hero's entrance played under the splash; play it again unless the language picker is up
        // (the picker replays it when it closes).
        if (!root.classList.contains('ask-lang')) {
          document.querySelectorAll<HTMLElement>('.hero-kicker, .hero h1, .hero-lead, .hero .hero-actions').forEach((el) => {
            el.style.animation = 'none';
            void el.offsetWidth;
            el.style.animation = '';
          });
        }
      }, 650);
    };
    splash.addEventListener('click', finish);
    setTimeout(finish, 6500); // never hold the page longer than this

    let loaded = document.readyState === 'complete';
    if (!loaded) addEventListener('load', () => (loaded = true), { once: true });
    lightPass(splash.querySelector<HTMLElement>('.light-logo')!, {
      until: () => loaded,
      cancelled: () => done,
      onDone: finish,
    });
  }
</script>

<style>
  .splash {
    display: none;
  }
  :global(html.splash) {
    overflow: hidden;
  }
  :global(html.splash) .splash {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background: #050505;
    cursor: pointer;
    transition: opacity 0.65s var(--ease);
  }
  .splash.leaving {
    opacity: 0;
  }
  .splash :global(.splash-logo) {
    width: min(40vw, 16rem);
  }
</style>
