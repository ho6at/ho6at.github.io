---
// The Luminoor Paris script logo, as used on the client brochure.
interface Props {
  href: string;
  size?: 'header' | 'footer';
}
const { href, size = 'header' } = Astro.props;
---

<a class:list={['logo', size]} href={href}>
  <picture>
    <source srcset="/brand/luminoor-logo.webp" type="image/webp" />
    <img src="/brand/luminoor-logo.png" alt="Luminoor Paris" width="556" height="166" />
  </picture>
</a>

<style>
  .logo {
    display: inline-block;
    line-height: 0;
  }
  img {
    width: auto;
    height: 2.6rem;
  }
  .footer img {
    height: 2.2rem;
  }
</style>
