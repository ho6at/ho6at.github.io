---
// App-style booking sheet where the visitor builds a custom session: kind of session → places, photos and
// people → add-ons → date and light → contact → summary. The price is worked out live by lib/pricing.ts
// (the same formula as the package prices shown elsewhere); scripts/home.ts drives the steps.
import { site } from '../site';
import { PRICES, PHOTO_TIERS, SHOOTS, PRESETS, MAX_LOCATIONS, MAX_OUTFITS, presetPrice, type Preset } from '../lib/pricing';
import { languages } from '../i18n/languages';
import type fr from '../i18n/fr';

interface Props {
  t: typeof fr;
}
const { t } = Astro.props;
const s = t.sessions;
const c = s.custom;
const num = (n: number) => new Intl.NumberFormat(t.locale).format(n);
const eur = (n: number) =>
  new Intl.NumberFormat(t.locale, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);
const shootLight = { street: 'day', couple: 'golden', proposal: 'blue', friends: 'dawn', portrait: 'day' } as const;
const lights = ['dawn', 'day', 'golden', 'blue'] as const;
const presets = Object.keys(PRESETS) as Preset[];
const presetName = (id: Preset) => s.packages.find((p) => p.id === id)?.name ?? id;
---

<dialog class="sheet" data-sheet aria-labelledby="sheet-title">
  <form class="sheet-inner" data-booking>
    <header class="sheet-head">
      <span class="grabber" aria-hidden="true"></span>
      <div>
        <p class="sheet-step" data-step-label></p>
        <h2 id="sheet-title" data-step-title>{s.steps[0]}</h2>
      </div>
      <button type="button" class="close" data-close aria-label={s.close}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
      <div class="progress" aria-hidden="true">
        {s.steps.map(() => <span />)}
      </div>
    </header>

    <div class="viewport">
      <div class="track" data-track-steps>
        <!-- 1. Kind of session -->
        <fieldset class="pane" data-pane>
          <legend class="sr-only">{c.shootLabel}</legend>
          <div class="options">
            {
              SHOOTS.map((id) => (
                <label class="option">
                  <input type="radio" name="shoot" value={id} checked={id === 'street'} />
                  <span class={`thumb plate plate-${shootLight[id]}`} aria-hidden="true" />
                  <span class="option-text">
                    <span class="option-name">{c.shoots[id].name}</span>
                    <span class="option-body">{c.shoots[id].text}</span>
                  </span>
                  {id === 'proposal' && <span class="option-add" dir="ltr">+{eur(PRICES.proposal)}</span>}
                </label>
              ))
            }
          </div>
          <p class="hint" data-proposal-note hidden>{c.proposalNote}</p>
        </fieldset>

        <!-- 2. Places, photos and people -->
        <div class="pane" data-pane>
          <div class="field">
            <span class="field-label">{c.presetsLabel}</span>
            <div class="presets">
              {
                presets.map((id) => (
                  <button type="button" class="preset" data-preset={id}>
                    <span class="preset-name">{presetName(id)}</span>
                    <span class="preset-price">{eur(presetPrice(id))}</span>
                  </button>
                ))
              }
            </div>
          </div>
          <div class="row">
            <div class="field">
              <span class="field-label" id="locations-label">{c.locationsLabel}</span>
              <div class="stepper" role="group" aria-labelledby="locations-label" data-stepper="locations" data-min="1" data-max={MAX_LOCATIONS}>
                <button type="button" data-step-by="-1" aria-label="−">−</button>
                <output>1</output>
                <button type="button" data-step-by="1" aria-label="+">+</button>
              </div>
              <input type="hidden" name="locations" value="1" />
            </div>
            <div class="field">
              <span class="field-label" id="people-label">{s.peopleLabel}</span>
              <div class="stepper" role="group" aria-labelledby="people-label" data-stepper="people" data-min="1" data-max="10">
                <button type="button" data-step-by="-1" aria-label="−">−</button>
                <output>1</output>
                <button type="button" data-step-by="1" aria-label="+">+</button>
              </div>
              <input type="hidden" name="people" value="1" />
            </div>
          </div>
          <fieldset>
            <legend class="field-label">{c.photosLabel}</legend>
            <div class="segments">
              {
                PHOTO_TIERS.map((n) => (
                  <label class="segment">
                    <input type="radio" name="photos" value={n} checked={n === 20} />
                    <span>{num(n)}</span>
                  </label>
                ))
              }
            </div>
            <p class="hint">{c.photosNote}</p>
          </fieldset>
          <p class="estimate">{c.durationLabel} <b data-duration></b></p>
        </div>

        <!-- 3. Add-ons -->
        <div class="pane" data-pane>
          <label class="toggle">
            <input type="checkbox" name="video" />
            <span class="toggle-text">
              <span class="toggle-name">{c.videoName}</span>
              <span class="toggle-body">{c.videoText}</span>
            </span>
            <span class="toggle-price" dir="ltr">+{eur(PRICES.video)}</span>
            <span class="switch" aria-hidden="true"></span>
          </label>
          <label class="toggle">
            <input type="checkbox" name="express" />
            <span class="toggle-text">
              <span class="toggle-name">{c.expressName}</span>
              <span class="toggle-body">{c.expressText}</span>
            </span>
            <span class="toggle-price" dir="ltr">+{eur(PRICES.express)}</span>
            <span class="switch" aria-hidden="true"></span>
          </label>
          <div class="toggle">
            <span class="toggle-text">
              <span class="toggle-name" id="outfits-label">{c.outfitsName}</span>
              <span class="toggle-body">{c.outfitsText}</span>
              <span class="toggle-price"><bdi dir="ltr">+{eur(PRICES.outfit)}</bdi> {c.each}</span>
            </span>
            <div class="stepper small" role="group" aria-labelledby="outfits-label" data-stepper="outfits" data-min="0" data-max={MAX_OUTFITS}>
              <button type="button" data-step-by="-1" aria-label="−">−</button>
              <output>0</output>
              <button type="button" data-step-by="1" aria-label="+">+</button>
            </div>
            <input type="hidden" name="outfits" value="0" />
          </div>
          <p class="hint">{s.extras}</p>
        </div>

        <!-- 4. Date and light -->
        <div class="pane" data-pane>
          <fieldset>
            <legend class="field-label">{s.dateLabel}</legend>
            <div class="dates" data-dates></div>
            <label class="flexible">
              <input type="checkbox" name="flexible" />
              <span>{c.flexibleDate}</span>
            </label>
          </fieldset>
          <fieldset>
            <legend class="field-label">{s.lightLabel}</legend>
            <div class="lights">
              {
                lights.map((l) => (
                  <label class={`light plate plate-${l}`}>
                    <input type="radio" name="light" value={l} checked={l === 'golden'} />
                    <span class="light-name">{t.light.names[l]}</span>
                    <span class="light-time" data-light-time={l} />
                  </label>
                ))
              }
            </div>
            <p class="hint" data-dawn-note hidden>{c.dawnNote.replace('{price}', `\u2066+${eur(PRICES.dawn)}\u2069`)}</p>
          </fieldset>
        </div>

        <!-- 5. Contact -->
        <div class="pane" data-pane>
          <label class="field">
            <span class="field-label">{s.nameLabel}</span>
            <input type="text" name="name" autocomplete="given-name" placeholder={s.namePlaceholder} />
          </label>
          <label class="field">
            <span class="field-label">{c.contactLabel}</span>
            <input type="text" name="contact" autocomplete="email" inputmode="email" dir="auto" placeholder={c.contactPlaceholder} />
          </label>
          <fieldset>
            <legend class="field-label">{c.langLabel}</legend>
            <div class="segments">
              {
                languages.map((l) => (
                  <label class="segment">
                    <input type="radio" name="lang" value={l.code} checked={l.code === t.lang} />
                    <span lang={l.code}>{l.name}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>
          <label class="field">
            <span class="field-label">{s.noteLabel}</span>
            <textarea name="note" rows="3" placeholder={s.notePlaceholder}></textarea>
          </label>
        </div>

        <!-- 6. Summary -->
        <div class="pane" data-pane>
          <div class="ticket plate plate-golden" data-ticket>
            <div class="ticket-inner">
              <img class="ticket-logo" src="/brand/luminoor-logo.png" alt="Luminoor Paris" width="556" height="166" />
              <p class="ticket-package" data-sum-shoot></p>
              <dl>
                <div><dt>{s.dateLabel}</dt><dd data-sum-date></dd></div>
                <div><dt>{s.lightLabel}</dt><dd data-sum-light></dd></div>
                <div><dt>{s.peopleLabel}</dt><dd data-sum-people></dd></div>
                <div><dt>{c.durationLabel}</dt><dd data-sum-duration></dd></div>
              </dl>
              <ul class="lines" data-sum-lines></ul>
              <p class="ticket-total"><span>{c.totalLabel}</span><b data-sum-price></b></p>
              <p class="ticket-note">{s.priceNote}</p>
            </div>
          </div>
          <div class="send">
            <a class="button" data-send-email href={`mailto:${site.email}`}>{s.sendEmail}</a>
            {site.whatsapp && <a class="button ghost" data-send-wa href={site.whatsapp}>{s.sendWhatsapp}</a>}
          </div>
          <p class="hint">{s.reassurance}</p>
        </div>
      </div>
    </div>

    <footer class="sheet-foot">
      <p class="live" aria-live="polite"><span>{c.totalLabel}</span><b data-live-total></b></p>
      <div class="foot-buttons">
        <button type="button" class="button ghost" data-back>{s.back}</button>
        <button type="button" class="button" data-next>{s.next}</button>
      </div>
    </footer>
  </form>
</dialog>

<style>
  .sheet {
    padding: 0;
    border: 0;
    margin: auto;
    width: min(40rem, calc(100vw - 2rem));
    max-height: min(52rem, calc(100svh - 3rem));
    border-radius: 28px;
    background: var(--surface);
    color: var(--ivory);
    box-shadow:
      0 0 0 1px var(--line),
      0 40px 120px -20px rgb(0 0 0 / 0.85);
    overflow: hidden;
  }
  .sheet::backdrop {
    background: rgb(5 5 4 / 0.6);
    backdrop-filter: blur(10px);
  }
  .sheet[open] {
    animation: sheet-in 0.55s var(--ease);
  }
  .sheet[open]::backdrop {
    animation: fade 0.4s ease;
  }
  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.98);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  .sheet-inner {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .sheet-head {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1rem;
    padding: 1.5rem 1.5rem 1rem;
  }
  .grabber {
    display: none;
  }
  .sheet-step {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .sheet-head h2 {
    font-size: 1.9rem;
  }
  .close {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: rgb(240 240 240 / 0.05);
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .close svg {
    width: 1.1rem;
    height: 1.1rem;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .progress {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.35rem;
    margin-top: 1rem;
  }
  .progress span {
    height: 3px;
    border-radius: 3px;
    background: var(--line);
    transition: background 0.5s var(--ease);
  }
  .progress span:global(.on) {
    background: var(--accent);
  }

  .viewport {
    overflow: hidden;
    flex: 1;
    min-height: 0;
  }
  .track {
    display: flex;
    height: 100%;
    transition: transform 0.55s var(--ease);
  }
  .pane {
    flex: 0 0 100%;
    min-width: 0;
    border: 0;
    margin: 0;
    padding: 0.5rem 1.5rem 1.5rem;
    overflow-y: auto;
    max-height: min(36rem, calc(100svh - 15rem));
    display: grid;
    grid-auto-rows: max-content;
    gap: 1.5rem;
    align-content: start;
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .field-label {
    display: block;
    padding: 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 0.7rem;
  }
  input[type='radio'],
  .dates :global(input) {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  /* Package options */
  .options {
    display: grid;
    gap: 0.75rem;
  }
  .option {
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding: 0.75rem;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: var(--raised);
    cursor: pointer;
    transition:
      border-color 0.3s var(--ease),
      background 0.3s var(--ease);
  }
  .option:has(input:checked) {
    border-color: var(--accent);
    background: linear-gradient(90deg, rgb(225 225 225 / 0.14), rgb(225 225 225 / 0.03));
  }
  .option:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .thumb {
    aspect-ratio: 1;
    border-radius: 14px;
  }
  .option-text {
    display: grid;
    gap: 0.1rem;
  }
  .option-name {
    font-family: var(--display);
    font-size: 1.45rem;
    line-height: 1.15;
  }
  .option-meta {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .option-body {
    font-size: 0.875rem;
    color: rgb(240 240 240 / 0.8);
  }
  .option-bonus {
    font-size: 0.85rem;
    color: #e6d6bd;
  }
  .option-best {
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 0.15rem;
  }
  .option-best b {
    font-weight: 500;
    color: var(--ivory);
  }
  .option-flag {
    position: absolute;
    top: -0.6rem;
    inset-inline-end: 1rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--champagne-foil);
    color: #2a241c;
    font-size: 0.7rem;
    font-weight: 600;
  }
  .option-price {
    font-family: var(--display);
    font-size: 1.4rem;
    color: var(--accent-soft);
    padding-inline-end: 0.4rem;
    white-space: nowrap;
  }

  .option-add {
    font-size: 0.9rem;
    color: var(--accent-soft);
    padding-inline-end: 0.4rem;
    white-space: nowrap;
  }

  /* Your session: presets, steppers, photo count */
  .presets {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .preset {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0.4rem;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: var(--raised);
    cursor: pointer;
    text-align: center;
    transition:
      border-color 0.3s var(--ease),
      background 0.3s var(--ease);
  }
  .preset:hover {
    border-color: var(--line-strong);
  }
  .preset:global(.on) {
    border-color: var(--accent);
    background: linear-gradient(180deg, rgb(225 225 225 / 0.12), rgb(225 225 225 / 0.03));
  }
  .preset-name {
    font-family: var(--display);
    font-size: 1.05rem;
  }
  .preset-price {
    font-size: 0.78rem;
    color: var(--accent-soft);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
  }
  .segments {
    display: flex;
    gap: 0.4rem;
    padding: 0.3rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--raised);
  }
  .segment {
    position: relative;
    flex: 1;
    cursor: pointer;
  }
  .segment span {
    display: block;
    padding: 0.6rem 0.3rem;
    border-radius: 999px;
    text-align: center;
    font-size: 0.95rem;
    transition:
      background 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .segment:has(input:checked) span {
    background: var(--ivory);
    color: #0a0a0a;
  }
  .segment:has(input:focus-visible) span {
    outline: 2px solid var(--accent);
  }
  .estimate {
    display: flex;
    justify-content: space-between;
    padding: 0.9rem 1rem;
    border-radius: 16px;
    background: rgb(240 240 240 / 0.04);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .estimate b {
    color: var(--ivory);
    font-weight: 500;
  }

  /* Add-ons */
  .toggle {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: var(--raised);
    cursor: pointer;
    transition: border-color 0.3s var(--ease);
  }
  div.toggle {
    cursor: default;
  }
  .toggle:has(input:checked) {
    border-color: var(--accent);
  }
  .toggle input[type='checkbox'] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .toggle-text {
    flex: 1;
    display: grid;
    gap: 0.15rem;
  }
  .toggle-name {
    font-family: var(--display);
    font-size: 1.25rem;
  }
  .toggle-body {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .toggle-price {
    font-size: 0.85rem;
    color: var(--accent-soft);
    white-space: nowrap;
  }
  .switch {
    flex: none;
    width: 2.9rem;
    height: 1.7rem;
    border-radius: 999px;
    background: rgb(240 240 240 / 0.14);
    position: relative;
    transition: background 0.3s var(--ease);
  }
  .switch::after {
    content: '';
    position: absolute;
    top: 0.2rem;
    inset-inline-start: 0.2rem;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 50%;
    background: var(--ivory);
    transition: transform 0.3s var(--ease);
  }
  .toggle:has(input:checked) .switch {
    background: var(--accent);
  }
  .toggle:has(input:checked) .switch::after {
    transform: translateX(1.2rem);
    background: #0a0a0a;
  }
  :global([dir='rtl']) .toggle:has(input:checked) .switch::after {
    transform: translateX(-1.2rem);
  }
  .toggle:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .stepper.small button {
    width: 2.2rem;
    height: 2.2rem;
  }
  .stepper.small output {
    min-width: 1.8rem;
    font-size: 1.25rem;
  }
  .flexible {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.8rem;
    font-size: 0.9rem;
    color: var(--muted);
    cursor: pointer;
  }
  .flexible input {
    accent-color: var(--accent);
    width: 1.05rem;
    height: 1.05rem;
  }
  .dates:global(.off) {
    opacity: 0.35;
    pointer-events: none;
    transition: opacity 0.3s var(--ease);
  }

  /* Date strip */
  .dates {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    margin-inline: -1.5rem;
    padding: 0.2rem 1.5rem 0.4rem;
  }
  .dates::-webkit-scrollbar {
    display: none;
  }
  .dates :global(label) {
    position: relative;
    flex: 0 0 4.4rem;
    scroll-snap-align: start;
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    padding: 0.7rem 0.3rem 0.65rem;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: var(--raised);
    cursor: pointer;
    transition:
      background 0.3s var(--ease),
      border-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .dates :global(label .wd) {
    font-size: 0.72rem;
    color: var(--muted);
    text-transform: capitalize;
  }
  .dates :global(label .dn) {
    font-family: var(--display);
    font-size: 1.6rem;
    line-height: 1.1;
  }
  .dates :global(label .gt) {
    font-size: 0.68rem;
    color: var(--accent-soft);
    font-variant-numeric: tabular-nums;
  }
  .dates :global(label:has(input:checked)) {
    background: var(--ivory);
    border-color: var(--ivory);
    color: #0a0a0a;
  }
  .dates :global(label:has(input:checked) .wd),
  .dates :global(label:has(input:checked) .gt) {
    color: #555555;
  }
  .dates :global(label:has(input:focus-visible)) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Light options */
  .lights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .light {
    aspect-ratio: 16 / 10;
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    cursor: pointer;
    border-radius: 18px;
    outline: 1px solid var(--line);
    outline-offset: -1px;
    transition: outline-color 0.3s var(--ease);
  }
  .light > span {
    position: relative;
    z-index: 2;
  }
  .light:has(input:checked) {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .light:has(input:focus-visible) {
    outline: 2px solid var(--ivory);
  }
  .light-name {
    font-family: var(--display);
    font-size: 1.3rem;
  }
  .light-time {
