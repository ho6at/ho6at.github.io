---
// La Chambre Noire, the contact sheet: the client's unfinished proofs, laid out like a film contact sheet. They
// circle their favourites with a red grease pencil (the package sets how many are included, more are extra) and
// pick a direction for each: Couleur, Noir or Libre (the photographer's choice). Nothing is edited on the page;
// the proofs are shown flat and marked "Épreuve", and the editing stays handwork in Lightroom.
// Choices are kept in this browser (localStorage) and sent by email for now.
import { site } from '../site';
import { PRICES } from '../lib/pricing';
import { chambre, directionText, directions, directionExample } from '../i18n/chambre';

interface Props {
  lang: 'fr' | 'en' | 'fa';
  locale: string;
  session: { id: string; name: string; date: string; quota: number; photos: { id: string; file: string; w: number; h: number }[] };
  home: string;
  reveal: string;
  demo?: boolean;
}
const { lang, locale, session, home, reveal, demo = false } = Astro.props;
const c = chambre[lang];
const D = directionText[lang];
const base = `/chambre/${session.id}/`;
const date = new Date(`${session.date}T12:00:00Z`).toLocaleDateString(locale, { day: 'numeric', month: 'long', timeZone: 'Europe/Paris' });
const strings = {
  ...c,
  directions: D,
  locale,
  email: site.email,
  name: session.name,
  session: session.id,
  quotaText: c.quota,
  extraText: c.extra,
  quota: session.quota,
  extraPrice: PRICES.extraPhoto,
};
// a hand-drawn loop, like a grease pencil on a contact sheet (drawn in a 100 × 100 box, stretched to the frame)
const loop = 'M52 6 C78 5 95 22 94 50 C93 79 74 95 47 94 C20 93 5 76 6 49 C7 23 25 8 49 7 C58 6.5 66 9 72 13';
---

<main class="chambre" data-chambre={JSON.stringify(strings)}>
  <header class="wrap ch-head">
    <a class="ch-logo" href={home} aria-label="Luminoor">
      <img src="/brand/luminoor-logo.png" alt="Luminoor Paris" width="556" height="166" />
    </a>
    <p class="ch-kicker">{c.kicker}</p>
    <h1 lang="fr" dir="ltr">La Chambre Noire</h1>
    <p class="ch-hello">{c.hello.replace('{name}', session.name).replace('{date}', date)}</p>
    <p class="ch-intro">{c.intro}</p>
    <p class="ch-craft">{c.craft}</p>
    {demo && <p class="ch-demo">{c.demo}</p>}
  </header>

  <!-- The directions, each shown with a finished photo from the portfolio -->
  <section class="wrap ch-dirs" aria-labelledby="dirs-title">
    <h2 id="dirs-title">{c.directionsTitle}</h2>
    <ul>
      {
        directions.map((d) => (
          <li>
            <img src={directionExample[d]} alt="" width="480" height="720" loading="lazy" decoding="async" />
            <p>
              <b lang="fr">{D[d].name}</b>
              <span>{D[d].text}</span>
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- The contact sheet -->
  <section class="sheet-film">
    <ul class="wrap ch-grid">
      {
        session.photos.map((p, i) => (
          <li class="tile" data-photo={p.id} data-file={p.file}>
            <button type="button" class="tile-open" data-open={i} aria-label={`${c.frame} ${i + 1}`}>
              <img src={`${base}${p.id}-480.webp`} alt="" width={p.w} height={p.h} loading="lazy" decoding="async" />
              <span class="proof-mark" aria-hidden="true">{c.proof}</span>
              <svg class="loop" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                <path d={loop} />
              </svg>
            </button>
            <p class="tile-edge" dir="ltr" aria-hidden="true">
              <span>{String(i + 12).padStart(2, '0')}</span>
              <span>▸ {String(i + 12).padStart(2, '0')}A</span>
            </p>
            <span class="tile-dir" aria-hidden="true" />
          </li>
        ))
      }
    </ul>
  </section>
  <p class="wrap ch-tap">{c.tap}</p>
  <p class="wrap ch-reveal"><a class="textlink" href={reveal}>{c.revealLink}</a></p>

  <!-- The bar that follows: how many photos are circled, what is extra, and sending -->
  <div class="ch-bar">
    <div class="ch-bar-inner">
      <p class="ch-count">
        <span data-quota></span>
        <span class="ch-extra" data-extra hidden></span>
      </p>
      <div class="ch-actions">
        <a class="button ghost small" data-let-us href={`mailto:${site.email}`}>{c.letUs}</a>
        <a class="button small" data-send href={`mailto:${site.email}`} aria-disabled="true">{c.send}</a>
      </div>
    </div>
  </div>

  <!-- The loupe -->
  <dialog class="viewer" data-viewer aria-label="La Chambre Noire">
    <div class="v-top">
      <button type="button" class="v-icon" data-close aria-label={c.close}>
        <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
      <p class="v-index" data-index dir="ltr"></p>
      <span class="v-space"></span>
    </div>
    <div class="v-stage" data-stage>
      <div class="v-frame" data-v-frame>
        <img data-v-img alt="" />
        <span class="proof-mark" aria-hidden="true">{c.proof}</span>
        <svg class="loop" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <path d={loop} />
        </svg>
      </div>
      <button type="button" class="v-nav prev" data-step="-1" aria-label={c.prev}>
        <svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <button type="button" class="v-nav next" data-step="1" aria-label={c.next}>
        <svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
    <div class="v-panel">
      <button type="button" class="v-mark" data-mark aria-pressed="false">
        <svg viewBox="0 0 100 100" aria-hidden="true"><path d={loop} /></svg>
        <span data-mark-label>{c.mark}</span>
      </button>
      <div class="v-dirs" role="radiogroup" data-dirs hidden>
        {
          directions.map((d) => (
            <button type="button" class="v-dir" role="radio" data-dir={d} aria-checked={d === 'libre' ? 'true' : 'false'}>
              <span class="v-dir-name" lang="fr">{D[d].name}</span>
              <span class="v-dir-text">{D[d].text}</span>
            </button>
          ))
        }
      </div>
      <input class="v-note" type="text" data-note placeholder={c.note} hidden />
    </div>
  </dialog>
</main>

<script>
  import { initChambre } from '../scripts/chambre';
  initChambre();
</script>

<style>
  .chambre {
    padding-bottom: 9rem;
  }
  .ch-head {
    padding-top: clamp(2rem, 6vw, 4rem);
    padding-bottom: 2rem;
    text-align: center;
  }
  .ch-logo img {
    height: 2.4rem;
    width: auto;
    opacity: 0.9;
  }
  .ch-kicker {
    margin-top: 2rem;
    font-size: 0.75rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #e6d6bd;
  }
  .ch-head h1 {
    margin-top: 0.6rem;
    font-family: 'Cinzel', 'Jost', serif;
    font-size: clamp(2.2rem, 7vw, 3.6rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    background: var(--champagne-foil);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ch-hello {
    margin-top: 1.2rem;
    font-size: 1.1rem;
  }
  .ch-intro,
  .ch-craft {
    max-width: 34rem;
    margin: 0.7rem auto 0;
    color: var(--muted);
    line-height: 1.7;
    text-wrap: balance;
  }
  .ch-craft {
    font-size: 0.9rem;
    color: #e6d6bd;
    opacity: 0.85;
  }
  .ch-demo {
    display: inline-block;
    margin-top: 1.2rem;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    border: 1px dashed var(--line-strong);
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* the directions */
  .ch-dirs {
    margin-bottom: 2.5rem;
  }
  .ch-dirs h2 {
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: center;
    margin-bottom: 1rem;
  }
  .ch-dirs ul {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 40rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .ch-dirs img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 6px;
  }
  .ch-dirs p {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.5rem;
    text-align: center;
  }
  .ch-dirs b {
    font-family: 'Cinzel', 'Jost', serif;
    font-weight: 400;
  }
  .ch-dirs span {
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* the contact sheet: dark film, frame numbers along the edge */
  .sheet-film {
    background: #0c0b0a;
    border-block: 1px solid rgb(240 240 240 / 0.06);
    padding-block: 1.5rem;
  }
  .ch-grid {
    list-style: none;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(30%, 11rem), 1fr));
    gap: 1rem 0.6rem;
  }
  .tile {
    position: relative;
  }
  .tile-open {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border: 0;
    background: #000;
    cursor: zoom-in;
    aspect-ratio: 2 / 3;
  }
  .tile-open img,
  .v-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* proofs look unfinished on purpose: flat and a little pale, as they come out of the camera */
    filter: saturate(0.55) contrast(0.82) brightness(1.05);
  }
  .v-frame img {
    object-fit: contain;
  }
  .proof-mark {
    position: absolute;
    left: 0.5rem;
    bottom: 0.45rem;
    font-size: 0.55rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.55);
    pointer-events: none;
  }
  .loop {
    position: absolute;
    inset: -4%;
    width: 108%;
    height: 108%;
    overflow: visible;
    pointer-events: none;
  }
  .loop {
    opacity: 0;
    transform: scale(0.9) rotate(-5deg);
    transition:
      opacity 0.35s var(--ease),
      transform 0.5s cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  .loop path {
    fill: none;
    stroke: #d23a2c;
    stroke-width: 2.6;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  :global(.is-marked) .loop {
    opacity: 1;
    transform: none;
  }
  .tile-edge {
    display: flex;
    justify-content: space-between;
    margin-top: 0.3rem;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: rgb(214 168 82 / 0.75);
    font-variant-numeric: tabular-nums;
  }
  .tile-dir {
    position: absolute;
    top: 0.4rem;
    inset-inline-end: 0.4rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: rgb(10 10 10 / 0.7);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: #e6d6bd;
    opacity: 0;
    transition: opacity 0.3s var(--ease);
    pointer-events: none;
  }
  .tile:global(.is-marked) .tile-dir {
    opacity: 1;
  }
  .ch-tap {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--muted);
    text-align: center;
  }
  .ch-reveal {
    margin-top: 1.2rem;
    text-align: center;
    font-size: 0.9rem;
  }

  /* the bar */
  .ch-bar {
    position: fixed;
    inset: auto 0 0;
    z-index: 20;
    padding: 0.75rem var(--gutter) max(0.9rem, env(safe-area-inset-bottom));
    background: linear-gradient(transparent, rgb(8 8 8 / 0.92) 30%);
  }
  .ch-bar-inner {
    max-width: 52rem;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1rem;
    padding: 0.8rem 1rem;
    border-radius: 22px;
    border: 1px solid var(--line);
    background: rgb(22 22 22 / 0.85);
    backdrop-filter: blur(14px);
  }
  .ch-count {
    display: grid;
    font-size: 0.9rem;
  }
  .ch-extra {
    font-size: 0.8rem;
    color: #e6d6bd;
  }
  .ch-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .button.small {
    padding: 0.65rem 1.1rem;
    font-size: 0.9rem;
  }
  .button[aria-disabled='true'] {
    opacity: 0.4;
    pointer-events: none;
  }

  /* the loupe */
  .viewer {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #050505;
    color: var(--ivory);
    display: none;
    flex-direction: column;
  }
  .viewer[open] {
    display: flex;
    animation: v-in 0.35s var(--ease);
  }
  @keyframes v-in {
    from {
      opacity: 0;
    }
  }
  .viewer::backdrop {
    background: #050505;
  }
  .v-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.8rem var(--gutter);
  }
  .v-icon,
  .v-nav {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: rgb(240 240 240 / 0.06);
    color: var(--ivory);
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .v-icon svg,
  .v-nav svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .v-space {
    width: 2.6rem;
  }
  .v-index {
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .v-stage {
    position: relative;
    flex: 1;
    min-height: 0;
    display: grid;
    place-items: center;
    padding: 0.75rem 1.5rem;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .v-frame {
    position: relative;
    height: 100%;
    max-width: 100%;
    aspect-ratio: 2 / 3;
  }
  .v-nav {
    position: absolute;
    top: 50%;
    margin-top: -1.3rem;
    display: none;
  }
  .v-nav.prev {
    inset-inline-start: 1rem;
  }
  .v-nav.next {
    inset-inline-end: 1rem;
  }
  :global([dir='rtl']) .v-nav svg {
    transform: scaleX(-1);
  }
  @media (hover: hover) {
    .v-nav {
      display: grid;
    }
  }
  .v-panel {
    display: grid;
    gap: 0.75rem;
    padding: 0.9rem var(--gutter) max(1rem, env(safe-area-inset-bottom));
    max-width: 40rem;
    width: 100%;
    margin: 0 auto;
  }
  .v-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-radius: 999px;
    border: 1px solid rgb(210 58 44 / 0.6);
    background: transparent;
    color: var(--ivory);
    font: inherit;
    cursor: pointer;
    transition: background 0.3s var(--ease);
  }
  .v-mark svg {
    width: 1.3rem;
    height: 1.3rem;
  }
  .v-mark path {
    fill: none;
    stroke: #d23a2c;
    stroke-width: 7;
    stroke-linecap: round;
  }
  .v-mark[aria-pressed='true'] {
    background: rgb(210 58 44 / 0.16);
  }
  .v-dirs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .v-dirs[hidden],
  .v-note[hidden] {
    display: none;
  }
  .v-dir {
    display: grid;
    gap: 0.1rem;
    padding: 0.6rem 0.4rem;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ivory);
    cursor: pointer;
    text-align: center;
    transition:
      background 0.3s var(--ease),
      border-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .v-dir[aria-checked='true'] {
    background: var(--ivory);
    border-color: var(--ivory);
    color: #0a0a0a;
  }
  .v-dir-name {
    font-family: 'Cinzel', 'Jost', serif;
    font-size: 0.95rem;
  }
  .v-dir-text {
    font-size: 0.68rem;
    opacity: 0.7;
  }
  .v-note {
    font: inherit;
    font-size: 0.9rem;
    color: var(--ivory);
    background: var(--raised);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 0.7rem 0.9rem;
  }
  .v-note:focus-visible {
    outline: none;
    border-color: #e6d6bd;
  }
  @media (prefers-reduced-motion: reduce) {
    .loop,
    .viewer[open] {
      transition: none;
      animation: none;
    }
  }
</style>
