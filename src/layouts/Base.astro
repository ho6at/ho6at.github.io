---
import '../styles/global.css';
import { site } from '../site';
import { languages } from '../i18n/languages';

interface Props {
  lang: string;
  title: string;
  description: string;
  /** Home pages: link the three language versions and ask for a language on each visit. */
  home?: boolean;
  /** Open Graph locale, e.g. fr_FR */
  ogLocale?: string;
  /** schema.org JSON-LD for this page */
  schema?: object;
  /** The same page in each language (hreflang); defaults to the home pages when `home` is set */
  alternates?: { code: string; href: string }[];
}
const { lang, title, description, home = false, ogLocale, schema } = Astro.props;
const alternates = Astro.props.alternates ?? (home ? languages.map((l) => ({ code: l.code, href: l.href })) : []);
const canonical = new URL(Astro.url.pathname, Astro.site);
const dir = languages.find((l) => l.code === lang)?.dir ?? 'ltr';
// Vazirmatn covers Persian text (the language picker uses it on every page; Google Fonts only downloads
// its glyphs where they appear). Reem Kufi sets the Persian headings; Cinzel the French and English hero title.
const fonts =
  'family=Jost:ital,wght@0,300..600;1,300..400&family=Vazirmatn:wght@200..600' +
  (lang === 'fa' ? '&family=Reem+Kufi:wght@400..600' : '&family=Cinzel:wght@400..500');
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    {
      home && (
        <script is:inline>
          // Ask for a language once per visit (LanguageGate); the choice lasts until the tab is closed.
          // The opening splash (Splash) also plays once per visit, before the language picker.
          try {
            const root = document.documentElement;
            // Coming to book (?book from a guide page): straight to the booking form.
            if (new URLSearchParams(location.search).has('book')) {
              sessionStorage.setItem('luminoor-lang-chosen', '1');
              sessionStorage.setItem('luminoor-splash', '1');
            }
            if (!sessionStorage.getItem('luminoor-lang-chosen')) root.classList.add('ask-lang');
            const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (!still && !sessionStorage.getItem('luminoor-splash')) {
              root.classList.add('splash');
              // Fail-safe: never leave the site hidden behind the splash.
              setTimeout(() => root.classList.remove('splash'), 7000);
            }
          } catch {}
        </script>
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!site.indexable && <meta name="robots" content="noindex" />}
    {alternates.map((l) => <link rel="alternate" hreflang={l.code} href={new URL(l.href, Astro.site)} />)}
    {
      alternates.length > 0 && (
        <link rel="alternate" hreflang="x-default" href={new URL(alternates.find((l) => l.code === 'fr')!.href, Astro.site)} />
      )
    }
    <meta property="og:site_name" content="Luminoor Paris" />
    <meta property="og:url" content={canonical} />
    {ogLocale && <meta property="og:locale" content={ogLocale} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Luminoor Paris" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
