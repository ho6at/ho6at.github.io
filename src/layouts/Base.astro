---
import '../styles/global.css';
import { site } from '../site';

interface Props {
  lang: string;
  title: string;
  description: string;
  altHref: string;
  altLang: string;
  askLanguage?: boolean;
}
const { lang, title, description, altHref, altLang, askLanguage = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {
      askLanguage && (
        <script is:inline define:vars={{ lang }}>
          // First visit: ask for a language (LanguageGate). Later visits to the French home page go
          // straight to English for visitors who chose it. A shared /en/ link is always respected.
          try {
            const saved = localStorage.getItem('luminoor-lang');
            if (!saved) document.documentElement.classList.add('ask-lang');
            else if (saved === 'en' && lang === 'fr' && location.pathname === '/') location.replace('/en/' + location.hash);
          } catch {}
        </script>
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!site.indexable && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang={altLang} href={new URL(altHref, Astro.site)} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,300..600;1,300..400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
