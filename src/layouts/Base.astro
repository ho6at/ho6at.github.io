---
import '../styles/global.css';
import { site } from '../site';
import { languages } from '../i18n/languages';

interface Props {
  lang: string;
  title: string;
  description: string;
  /** Home pages: link the three language versions and ask for a language on each visit. */
  home?: boolean;
}
const { lang, title, description, home = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const dir = languages.find((l) => l.code === lang)?.dir ?? 'ltr';
// Vazirmatn covers Persian; Google Fonts only downloads its glyphs on pages that use them.
const fonts = 'family=Jost:ital,wght@0,300..600;1,300..400&family=Vazirmatn:wght@200..600';
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    {
      home && (
        <script is:inline>
          // Ask for a language once per visit (LanguageGate); the choice lasts until the tab is closed.
          try {
            if (!sessionStorage.getItem('luminoor-lang-chosen')) document.documentElement.classList.add('ask-lang');
          } catch {}
        </script>
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!site.indexable && <meta name="robots" content="noindex" />}
    {home && languages.map((l) => <link rel="alternate" hreflang={l.code} href={new URL(l.href, Astro.site)} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
